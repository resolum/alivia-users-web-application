# Base API URL, including the version. Endpoint paths are relative to it.
#VITE_API_BASE_URL=https://alivia-api.azurewebsites.net/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# IAM endpoints, relative to VITE_API_BASE_URL (no leading slash).
VITE_IAM_VERIFY_EMAIL_ENDPOINT_PATH=auth/verify-email
VITE_IAM_SIGN_UP_ENDPOINT_PATH=auth/sign-up
VITE_IAM_SIGN_IN_ENDPOINT_PATH=auth/sign-in
VITE_IAM_RESEND_VERIFICATION_ENDPOINT_PATH=auth/resend-verification
VITE_IAM_REFRESH_ENDPOINT_PATH=auth/refresh
VITE_IAM_LOGOUT_ENDPOINT_PATH=auth/logout
VITE_IAM_FORGOT_PASSWORD_ENDPOINT_PATH=auth/forgot-password
VITE_IAM_RESET_PASSWORD_ENDPOINT_PATH=auth/reset-password
VITE_IAM_CHANGE_PASSWORD_ENDPOINT_PATH=auth/change-password

# Profiles endpoints, relative to VITE_API_BASE_URL.
VITE_PROFILES_ENDPOINT_PATH=person-profiles

# Technical evaluation (appointments).
VITE_APPOINTMENTS_ENDPOINT_PATH=appointments
VITE_APPOINTMENT_HOLDS_ENDPOINT_PATH=appointments/holds/{draftId}

# Care agenda.
VITE_CARE_AGENDA_ENDPOINT_PATH=care-agenda

# Assisted person care profiles.
VITE_ASSISTED_PERSON_CARE_PROFILE_ENDPOINT_PATH=assisted-person-care-profiles/mine

# Medication administrations.
VITE_MEDICATION_ADMINISTRATIONS_ENDPOINT_PATH=medication-administrations
VITE_MEDICATION_OUTCOMES_ENDPOINT_PATH=medication-administrations/{administrationId}/outcomes

# Hiring configuration and payment.
VITE_CONFIGURATION_DRAFTS_ENDPOINT_PATH=configuration-drafts
VITE_CONFIGURATION_DRAFT_CONFIRMATION_ENDPOINT_PATH=configuration-drafts/{draftId}/confirmation
VITE_CONFIGURATION_DRAFT_TRACKING_ENDPOINT_PATH=configuration-drafts/{draftId}/tracking
VITE_MY_CONFIGURATION_DRAFTS_ENDPOINT_PATH=configuration-drafts/mine
VITE_CONFIGURATION_DRAFT_OWNER_ENDPOINT_PATH=configuration-drafts/{draftId}/owner

# Plans.
VITE_PLANS_ENDPOINT_PATH=plans

# Support incidents.
VITE_SUPPORT_INCIDENTS_ENDPOINT_PATH=support-incidents
VITE_SUPPORT_INCIDENT_EVIDENCE_PHOTO_ENDPOINT_PATH=support-incidents/{incidentId}/evidences/photo
VITE_SUPPORT_INCIDENT_REPORTS_ENDPOINT_PATH=support-incidents/reports
VITE_SUPPORT_INCIDENT_DEVICES_ENDPOINT_PATH=support-incidents/devices
