# Backend used by the public plan catalog. Keep the mock enabled for standalone UI work.
VITE_API_BASE_URL=
VITE_SUBSCRIPTIONS_PLANS_PATH=/api/v1/plans
VITE_SUBSCRIPTIONS_DRAFTS_PATH=/api/v1/configuration-drafts
VITE_SUBSCRIPTIONS_MOCK=false
# Technical evaluation booking (operations context)
VITE_OPERATIONS_APPOINTMENTS_PATH=/api/v1/appointments
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# IAM settings
VITE_IAM_MOCK=true
VITE_IAM_SIGN_IN_ENDPOINT_PATH=/api/v1/authentication/sign-in
VITE_IAM_REFRESH_ENDPOINT_PATH=/api/v1/authentication/refresh
VITE_IAM_FORGOT_PASSWORD_ENDPOINT_PATH=/api/v1/authentication/forgot-password
VITE_IAM_RESET_PASSWORD_ENDPOINT_PATH=/api/v1/authentication/reset-password
